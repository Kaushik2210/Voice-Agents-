# Copy to .env and adjust. Everything here is local.

# VoiceStudio local API (OpenAI-compatible audio endpoint, default port 3900)
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=

# Ollama (pull the model first: `ollama pull llama3.1:8b`)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192

# Speaker labels (optional). Needs ffmpeg, `pip install sherpa-onnx numpy` and two
# model files in SPEAKER_MODELS_DIR; see the README. Without them, no labels.
DIARIZE=true
SPEAKER_MODELS_DIR=./models
NUM_SPEAKERS=2

# Privacy
KEEP_AUDIO=false
REDACT_IDENTIFIERS=true
RETENTION_DAYS=30

# Set a long random value so only your UI can call the API
API_KEY=
